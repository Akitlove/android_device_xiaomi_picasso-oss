# Allow hal_power_default to write to dt2w nodes
allow hal_power_default input_device:dir r_dir_perms;
allow hal_power_default input_device:chr_file rw_file_perms;

allow hal_power_default sysfs_touchpanel:dir search;
allow hal_power_default sysfs_touchpanel:file rw_file_perms;

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Allow powerhal to use qcom system nodes
allow hal_power_default sysfs_msm_subsys:dir search;
allow hal_power_default sysfs_msm_subsys:file rw_file_perms;

# Allow powerhal to configure UFS clock gate status
allow hal_power_default vendor_sysfs_scsi_host:file rw_file_perms;

# Allow powerhal to listen double tap event
allow hal_power_default vendor_sysfs_double_tap:file rw_file_perms;

allow hal_power_default proc:file { open };
allow hal_power_default fwk_stats_service:service_manager { find };

# Rule for hal_power_default to access graphics composer process
unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default);
